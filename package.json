{
  "name": "model-viewer-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Research and design for a browser CAD viewer library. The publishable library package arrives in build slice 1 (see SPEC.md).",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "assets": "bash scripts/fetch-assets.sh",
    "probe:step": "node research/probe-step.mjs",
    "probe:truth": "node research/d8-ground-truth.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "dependencies": {
    "occt-import-js": "^0.0.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
