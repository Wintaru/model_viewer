# Dependencies
node_modules/

# Build output (commit 12: tsc --project tsconfig.build.json)
dist/

# Test corpus — 75 MB of binary CAD files.
# Fetch them with scripts/fetch-assets.sh. The README stays tracked, because it
# records provenance and licensing for every file.
assets/*
!assets/README.md

# Third-party CAD files that are not ours to publish.
# demo/private holds output decoded from a real customer part: full geometry,
# part numbers, and internal folder paths. It must never be committed.
# ESLint's flat config does not read this file, so eslint.config.js repeats
# this entry in its own `ignores` — keep the two in sync.
demo/private/

# Claude's working decision log. Delete this line to track it.
DECISIONS.md

# Claude's hand-off files (Trillian's *-HANDOFF.md / *-CHECKLIST.md
# convention) — working notes for Josh, not tracked docs. Delete a specific
# line here to track that one file.
*-HANDOFF.md
*-CHECKLIST.md

# Trillian per-repo settings
.trillian-repo.json

# Scratch
*.log
.DS_Store
.playwright-mcp/
mermaid-*.png

# Python bytecode cache. research/d22-definition-probe.py is importable, so
# running the scripts creates this.
__pycache__/
